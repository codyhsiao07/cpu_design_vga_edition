# Normalize line endings for repository
*.v   text eol=lf
*.sv  text eol=lf
*.vh  text eol=lf
*.txt text eol=lf
*.md  text eol=lf

# Captured benchmark evidence is byte-exact, including log whitespace.
benchmarks/results/** -text -whitespace

# Exported report text remains portable across platforms.
docs/report_assets/*.svg text eol=lf -whitespace
docs/report_assets/*.json text eol=lf

