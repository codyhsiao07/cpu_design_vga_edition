        </mxCell>
        <mxCell id="m_ddr" value="DDR-backed RAM&#xA;0x8000_0000 - 0x87FF_FFFF&#xA;128 MiB&#xA;program, rodata, data, heap, stack" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="m1">
          <mxGeometry x="85" y="150" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="m_alias" value="Low-address DDR alias&#xA;0x0000_0000 - 0x07FF_FFFF&#xA;effective address = addr + 0x8000_0000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13" vertex="1" parent="m1">
          <mxGeometry x="85" y="285" width="360" height="88" as="geometry" />
        </mxCell>
        <mxCell id="m_uart" value="UART / launcher MMIO&#xA;0x4000_0000 TX DATA&#xA;0x4000_0004 TX STATUS&#xA;0x4000_0008 RX DATA&#xA;0x4000_000C RX STATUS&#xA;0x4000_0010 launcher status&#xA;0x4000_0014 reset request" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="m1">
          <mxGeometry x="85" y="405" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m_vga" value="VGA framebuffer MMIO&#xA;0x5000_0000 - 0x5000_7FFF&#xA;control register: 0x5000_7FFC&#xA;implemented as local BRAM framebuffer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="m1">
          <mxGeometry x="85" y="585" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="m_icache" value="I-Cache&#xA;production: 64 KiB&#xA;2-way set associative&#xA;64-byte line&#xA;line refill through L2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="m1">
          <mxGeometry x="570" y="150" width="360" height="115" as="geometry" />
        </mxCell>
        <mxCell id="m_dcache" value="D-Cache&#xA;production: 128 KiB&#xA;2-way set associative&#xA;64-byte line&#xA;write-back, no-write-allocate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="m1">
          <mxGeometry x="570" y="300" width="360" height="125" as="geometry" />
        </mxCell>
        <mxCell id="m_l2" value="Unified L2 Cache&#xA;production: 256 KiB&#xA;2-way set associative&#xA;64-byte line&#xA;write-back, write-allocate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="m1">
          <mxGeometry x="570" y="465" width="360" height="125" as="geometry" />
        </mxCell>
        <mxCell id="m_widths" value="Bus width summary&#xA;CPU data path: 32-bit&#xA;L1 to L2: 64-bit beats&#xA;L2 line transfer: 8 beats per 64B line&#xA;MIG app data: 128-bit beats" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#82b366;fontSize=13" vertex="1" parent="m1">
          <mxGeometry x="570" y="630" width="360" height="115" as="geometry" />
        </mxCell>
        <mxCell id="m_boot" value="UART boot flow&#xA;host sends .mem image through UART&#xA;bootloader writes DDR2 at BOOT_ADDR&#xA;BOOT_ADDR = 0x8000_0000&#xA;RESET_PC = 0x8000_0000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="m1">
          <mxGeometry x="1055" y="150" width="360" height="125" as="geometry" />
        </mxCell>
        <mxCell id="m_mux" value="MIG app mux priority&#xA;1. ddr_app_memtest&#xA;2. uart_bootloader&#xA;3. L2 cache runtime requests" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="m1">
          <mxGeometry x="1055" y="315" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m_l2_policy" value="L2 arbitration policy&#xA;uncached requests first&#xA;D$ has priority over I$&#xA;one selected master is held until rsp_last" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13" vertex="1" parent="m1">
          <mxGeometry x="1055" y="455" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="m_fast" value="Build configuration note&#xA;FAST_SIM and FAST_SYNTH shrink cache arrays&#xA;to speed simulation or FPGA iteration.&#xA;The clean overview shows production defaults." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=13" vertex="1" parent="m1">
          <mxGeometry x="1055" y="600" width="360" height="105" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
