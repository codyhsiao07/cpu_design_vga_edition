        <mxCell id="note-if" value="IF：PC 選擇下一個取指位址，Instruction Cache 回傳指令，並將 instruction、PC、PC+4 寫入 IF/ID register。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d2c3;fontSize=18;fontColor=#111111;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1060" width="430" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="note-id" value="ID：Control Unit 產生控制訊號，Register File 讀取 rs1 / rs2，Immediate Generator 產生立即值；Hazard Detection 控制 stall / flush。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d2c3;fontSize=18;fontColor=#111111;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1060" width="430" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="note-ex" value="EX：Operand MUX 選擇暫存器、立即值或 forwarding data；ALU / Mul-Div Unit 完成運算，Branch Unit 產生跳躍目標與 flush 控制。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d2c3;fontSize=18;fontColor=#111111;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="1060" width="560" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="note-mem" value="MEM：依照 EX/MEM register 的位址與控制訊號執行 load / store；MMIO Decoder 將特定位址導向 UART、VGA Framebuffer 或 GPIO。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d2c3;fontSize=18;fontColor=#111111;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1690" y="1060" width="500" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="note-wb" value="WB：Writeback MUX 從 ALU result、memory read data 或 PC+4 選出寫回資料，最後更新 rd 暫存器。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d2c3;fontSize=18;fontColor=#111111;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="2260" y="1060" width="280" height="145" as="geometry"/>
        </mxCell>

