        <mxCell id="mem_file" value=".mem file&#xA;32-bit hex words" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="95" y="160" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="send_script" value="uart_send_mem.py&#xA;little-endian byte stream" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="95" y="285" width="200" height="76" as="geometry" />
        </mxCell>
        <mxCell id="protocol" value="UART packet&#xA;SYNC 0xC0DE5A5A&#xA;length N&#xA;N payload bytes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="95" y="430" width="200" height="105" as="geometry" />
        </mxCell>
        <mxCell id="com_note" value="Default baud: 115200&#xA;USB-UART board link" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="95" y="600" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wait_calib" value="S_WAIT&#xA;wait for MIG calibration&#xA;and DDR memtest done" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="430" y="150" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sync_detect" value="S_SYNC&#xA;detect sync word&#xA;select working RX stream" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="690" y="150" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="read_len" value="S_LEN&#xA;read 4-byte length&#xA;0 bytes -&gt; S_DONE&#xA;&gt; 8 MiB -&gt; resync" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="950" y="150" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rx_fifo" value="RX FIFO&#xA;64-byte elastic buffer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="505" y="315" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="data_buffer" value="S_DATA&#xA;collect payload bytes&#xA;pack 16 bytes into 128-bit buffer&#xA;generate byte mask" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="735" y="300" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="send_write" value="S_SEND&#xA;MIG WRITE command&#xA;app_addr = curr_addr - DDR_BASE&#xA;app_wdf_data = 128-bit payload" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="720" y="480" width="250" height="112" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="S_VERIFY_REQ / WAIT&#xA;read back first 3 x 128-bit blocks&#xA;compare against expected bytes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="440" y="500" width="220" height="96" as="geometry" />
        </mxCell>
        <mxCell id="done" value="S_DONE&#xA;boot_done_o = 1&#xA;CPU reset can be released" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="735" y="635" width="220" height="78" as="geometry" />
        </mxCell>
        <mxCell id="mux" value="MIG app mux&#xA;memtest &gt; bootloader &gt; L2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1240" y="265" width="230" height="82" as="geometry" />
        </mxCell>
        <mxCell id="mig" value="Xilinx MIG DDR2&#xA;native app_* interface&#xA;128-bit write data" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1240" y="430" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ddr" value="External DDR2 SDRAM&#xA;BOOT_ADDR = 0x8000_0000&#xA;program image stored here" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="1">
